# Placeholders only. Used by `docker compose up` (copy to .env, which is gitignored).
# Values with a $ (the bcrypt hash) MUST be wrapped in single quotes, otherwise
# Compose treats $... as variable interpolation and corrupts the hash.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='{bcrypt}$2a$10$change-me'
OPENROUTER_API_KEY=sk-or-change-me
# OpenRouter model IDs: a cheap/fast one for classification, a higher quality one for replies
AI_MODEL_CLASSIFY=provider/cheap-model
AI_MODEL_REPLY=provider/quality-model
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_AI_PER_MINUTE=10
