# Placeholders only. Copy to .env (gitignored) and fill in real values.
DATABASE_URL=jdbc:postgresql://localhost:5432/support_inbox
DATABASE_USERNAME=support_inbox
DATABASE_PASSWORD=change-me
ADMIN_USERNAME=admin
# Encoded password, e.g. {bcrypt}$2a$10$...  (never a plaintext password)
ADMIN_PASSWORD_HASH={bcrypt}change-me
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
OPENROUTER_API_KEY=sk-or-change-me
AI_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter model IDs: a cheap/fast one for classification, a higher quality one for replies
AI_MODEL_CLASSIFY=provider/cheap-model
AI_MODEL_REPLY=provider/quality-model
# Global cap on AI-triggering requests (POST /api/messages and /regenerate) per minute
RATE_LIMIT_AI_PER_MINUTE=10
