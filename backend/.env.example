# Placeholders only. Copy to .env (gitignored) and fill in real values.
DATABASE_URL=jdbc:postgresql://localhost:5432/support_inbox
DATABASE_USERNAME=support_inbox
DATABASE_PASSWORD=change-me
ADMIN_USERNAME=admin
# Encoded password, e.g. {bcrypt}$2a$10$...  (never a plaintext password)
ADMIN_PASSWORD_HASH={bcrypt}change-me
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
